{
    "name": "cursorCharCode",
    "displayName": "Unicode code point of current character",
    "description": "Shows the Unicode code point of character under cursor in the status bar.",
    "version": "0.4.0",
    "publisher": "zeithaste",
    "engines": {
        "vscode": "^1.92.0"
    },
    "categories": [
        "Other"
    ],
    "galleryBanner": {
        "color": "#33A4C4",
        "theme": "dark"
    },
    "icon": "ccc_icon.png",
    "keywords": [
        "Unicode",
        "character",
        "codepoint",
        "cursor"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/zeithaste/cursorCharCode"
    },
    "pricing": "Free",
    "bugs": {
        "url": "https://github.com/zeithaste/cursorCharCode/issues",
        "email": "zeithaste@gmail.com"
    },
    "activationEvents": [
        "onStartupFinished"
    ],
    "main": "./dist/extension.js",
    "scripts": {
        "vscode:prepublish": "npm run check && npm run bundle:production",
        "check": "npm run check-types && npm run lint",
        "check-types": "tsc --noEmit",
        "compile": "npm run check-types && npm run bundle",
        "bundle": "node scripts/esbuild.mjs",
        "bundle:production": "node scripts/esbuild.mjs --production",
        "compile-tests": "node scripts/esbuild.mjs --tests",
        "prepare-tests": "npm run compile && npm run compile-tests",
        "lint": "eslint \"src/**/*.ts\"",
        "test": "npm run check && npm run test:unit",
        "test:unit": "npm run compile-tests && mocha --ui tdd \"out/test/grapheme.test.js\"",
        "test:integration": "npm run test:integration:minimum && npm run test:integration:stable",
        "test:integration:minimum": "npm run prepare-tests && vscode-test --config .vscode-test.minimum.mjs",
        "test:integration:stable": "npm run prepare-tests && vscode-test --config .vscode-test.mjs",
        "vsix": "vsce package --no-dependencies",
        "watch": "node scripts/esbuild.mjs --watch",
        "watch:types": "tsc --noEmit --watch"
    },
    "devDependencies": {
        "@eslint/js": "10.0.1",
        "@types/mocha": "10.0.10",
        "@types/node": "20.14.15",
        "@types/vscode": "1.92.0",
        "@vscode/test-cli": "0.0.15",
        "@vscode/test-electron": "3.1.0",
        "@vscode/vsce": "3.9.2",
        "esbuild": "0.28.1",
        "eslint": "10.8.0",
        "mocha": "11.7.6",
        "typescript": "6.0.3",
        "typescript-eslint": "8.65.0"
    },
    "contributes": {
        "commands": [
            {
                "category": "CursorCharCode",
                "command": "cursorCharCode.convertToXX",
                "title": "Replace character to \\xFF form"
            },
            {
                "category": "CursorCharCode",
                "command": "cursorCharCode.convertToXXXX",
                "title": "Replace character to \\uFFFF form"
            },
            {
                "category": "CursorCharCode",
                "command": "cursorCharCode.convertToXXXXXXXX",
                "title": "Replace character to \\UFFFFFFFF form"
            },
            {
                "category": "CursorCharCode",
                "command": "cursorCharCode.hexToClipboard",
                "title": "Copy current character code (hexadecimal) to the clipboard"
            },
            {
                "category": "CursorCharCode",
                "command": "cursorCharCode.decToClipboard",
                "title": "Copy current character code (decimal) to the clipboard"
            }
        ]
    },
    "dependencies": {
        "unicode-name": "1.1.0"
    },
    "allowScripts": {
        "@vscode/vsce-sign@2.0.9": true,
        "esbuild@0.28.1": true,
        "keytar@7.9.0": true
    }
}
